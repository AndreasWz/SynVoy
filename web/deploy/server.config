// Nextflow settings for searches started by the web service: `-c` on top of the
// profile named in the service's settings ("nextflow_profile").
//
// EXAMPLE VALUES for a machine with 64 GB of memory and 16 cores, used with
// `-profile auto`. They have not been measured on such a machine. Before opening the
// site, run one search per group of genomes with the largest genomes you offer
// (tests/test_end_to_end.py does this with your settings) and adjust.
//
// What is known (measured on other machines, see docs/USAGE.md "Memory tiers"):
//   * `low_mem` (the launcher's default) gives MMseqs2 a 2 GB split limit. That is
//     enough for genomes of a few hundred Mb and too little for a 3 Gb genome.
//   * A 3.2 Gb genome needed a split limit of 6G, a 3.6 Gb genome 8G.
//   * One genome-wide search needs about 3.5 times the genome size in working space.

params {
    iterative_search_cpus     = 14
    iterative_search_memory   = '40 GB'
    iterative_search_max_forks = 1
    locate_gene_cpus          = 8
    locate_gene_memory        = '8 GB'
    mmseqs_split_memory_limit = '16G'

    // The gene tree (MAFFT + IQ-TREE) is switched off by `low_mem` only; with
    // `-profile auto` it is on. Set true to save time; the result page then has no
    // "Gene tree" tab.
    skip_tree = false
}
