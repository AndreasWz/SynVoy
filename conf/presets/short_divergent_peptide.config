// SynVoy preset: short divergent peptide (< ~100 aa)
//
// For: short secreted peptides, micro-exon toxins, antimicrobial peptides,
// small venom components. Examples: melittin (70 aa), defensins, mastoparan,
// small 3FTx toxins (snake venom).
//
// Why this preset: a single missed exon is a large share of a short protein, so
// the default coverage thresholds of the model status call a nearly complete
// short gene model a fragment.
//
// Validated on: melittin benchmark (results/melettin_benchmark/) — recovers
// 11/12 GR2-family orthologs across 200 Myr of Hymenoptera.
//
// Use:   nextflow run main.nf -profile standard,preset_short_peptide ...
//   or:  nextflow run main.nf -c conf/presets/short_divergent_peptide.config ...
//
// Revised 2026-10-08: min_query_length is no longer set here (the preset is chosen after
// the length check has run; the default is 20 now), and MEDIUM is 30 instead of 25.
// Revised 2026-10-09: four hit floors removed (they did not bind, see below).
// Revised 2026-10-15: the identity thresholds (HIGH 40, MEDIUM 30, tandem 40) are gone with
// the identity-based label; one judge labels every GOI call (docs/ALGORITHM.md 7.8).

params {
    // Not set here any more (2026-10-09): sw_min_score, sw_min_identity, min_hit_identity,
    // min_hit_length. Lowering them changed nothing: the E-value filters of the search are
    // stricter than these floors (see bin/resolve_effective_params.py).

    // Coverage thresholds tuned for ~70 aa proteins: a single missed exon
    // (~30 aa) drops a melittin hit below the default qcov=0.7 "complete" bar.
    // These set ModelStatus (fragment / partial / complete) only, not the label.
    classify_complete_min_qcov   = 0.5
    classify_fragment_max_qcov   = 0.3
}
