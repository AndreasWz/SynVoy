// SynVoy preset: paralog discrimination (close paralog family)
//
// For: gene families with a small number of close paralogs that need to be
// distinguished, NOT lumped together. Examples: TP53/TP63/TP73, SOX1-21,
// HOX clusters, paired ZNFs. Different from `preset_tandem_family` because
// the family has 2–10 members (not dozens of tandem copies) and you want
// SynVoy to call each paralog at its own syntenic locus.
//
// Why this preset: tight adaptive region selection prevents the tail of LOW-score
// candidate regions that the relatives of such a gene draw (in TP53 runs: noise regions
// at synteny score 0.15–0.20). It acts on the candidate regions (regions.bed, the
// figures), not on the labels of the GOI calls.
//
// Family names: `--goi_family_tokens 'TP53,TP63,TP73,TRP53,TRP63,TRP73,P53,P63,P73'`
// (or conf/tp53_strict.config) records on every GOI row whether the target's own
// annotation carries one of them (GoiFamilyConsistent). Annotation only: it changes no
// label. This preset sets no names of its own.
//
// Use:   nextflow run main.nf -profile standard,preset_paralog_discrimination \
//          --goi_family_tokens 'TP53,TP63,TP73' ...
//   or:  nextflow run main.nf -c conf/presets/paralog_discrimination.config \
//          --goi_family_tokens 'TP53,TP63,TP73' ...
//
// Under --modules legacy the preset chooser picks this preset when the query aligns
// strongly at two or more places of the home genome (the second at least half as strong
// as the first; bin/auto_select_preset.py, docs/PARAMETERS.md § 1). The dispersed_family
// module (A2) sets the same values and one more.

params {
    // Tighter adaptive region selection — kills the LOW-score noise tail.
    adaptive_score_floor_frac  = 0.45
    adaptive_score_floor_abs   = 0.08
    adaptive_max_regions       = 4
}
