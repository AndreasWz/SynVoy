manifest {
    name = 'SynVoy'
    description = 'Synteny-guided gene finding across genomes using iterative search'
    mainScript = 'main.nf'
    version = '1.0.0'
    nextflowVersion = '>=25.10.0'   // matches environment.yml + INSTALL.md; floor of the tested/hardened range
}


params {
    // Input - Query
    query = null          // Path to local query FASTA file (Pro Mode or Easy Mode with file input)
    query_id = null       // UniProt/NCBI Accession ID (Easy Mode)
    query_seq = null      // Inline protein sequence or FASTA text (Easy Mode)
    
    // Mode selection
    mode = 'easy'         // 'easy' or 'pro'
    
    // Easy mode
    home_species = null   // Optional. Easy-mode home species name override. Automatically detected otherwise.
    allow_unknown_species = false  // Pro-mode opt-out for the §1i hard gate. When --home_species is
                                    // unset AND the genome filename can't be parsed into a plausible
                                    // species name, the run is refused by default — set this true to
                                    // proceed with kingdom=Unknown / phylo distance 999 anyway.
    max_genomes = 0       // 0 = Auto-detect based on taxonomy (3 per level). Or specify count.
    target_species = null // Comma-separated species names (e.g., "Ooceraea biroi,Harpegnathos saltator")
    assembly_ranking = 'hybrid'  // easy-mode selection: hybrid, counts, nstats
    bad_quality_policy = 'drop'  // easy-mode low-quality handling: ask, drop, keep
    bad_quality_timeout = 300    // seconds to wait for answer when policy=ask
    bad_max_contigs = 500000     // above this contig count => low quality
    bad_max_scaffolds = 500000    // above this scaffold count => low quality
    bad_min_n50 = 5000            // below this best-N50 => low quality
    qc_fail_policy = 'drop'      // downstream target filtering after QC: drop or keep
    
    // Pro mode  
    home_genome = null    // Path to home genome FASTA
    home_gff = null       // Path to home genome GFF (optional)
    target_genomes = null // Glob, comma-separated paths, or list (e.g., "genomes/*.fna" or "a.fna,b.fna")
    
    // Synteny parameters
    n_flanking_genes = 10        // Non-GOI-similar flanking genes to select per side
    prefer_large_genes = true
    min_flanking_size = 500
    exon_level_search = true     // Search at exon level for better divergent gene detection
    // Flanking gene quality filter: exclude flanking candidates with k-mer similarity
    // above this threshold to the GOI (catches LY6/3FTx family members, GPI-anchored
    // proteins, etc. that are useless as cross-species synteny anchors).
    // Set to 100 to disable (accept all flanking genes regardless of GOI similarity).
    max_flanking_goi_similarity = 35.0
    // Max distance (bp) from GOI center to walk for flanking genes.
    // 0 = unlimited (legacy). Set e.g. 500000 to prevent reaching into gene deserts
    // when the GOI neighbours a tandem array that fills one side (e.g. Y-e3 + MRJP cluster).
    max_flanking_distance = 0
    // When true, GOI-similar genes within expand_goi_similar_distance bp of the GOI are
    // emitted as additional GOI queries (GOI_NEIGHBOR_ prefix). They are searched in all
    // target genomes and included in IQ-TREE.
    //
    // OFF BY DEFAULT (was previously on, reverted 2026-04-25): for paralog-rich gene
    // families like LY6 the NEIGHBOR queries flood the per-target m8 with paralog
    // matches, causing the synteny-anchor signal to flatten and the true ortholog
    // scaffold to drop out of the top-`adaptive_max_regions`. LY6 baseline went from
    // 8/9 scaffold recall (off) to 0/9 (on). It can still help in narrow cases
    // (single-copy gene with known nearby tandem duplicates that are the targets
    // themselves, e.g. some venom peptides) — opt in explicitly with
    // `--expand_goi_similar true`. See docs/PARAMETERS.md for trade-offs.
    expand_goi_similar = false
    expand_goi_similar_distance = 300000
    
    // Search parameters
    cluster_distance = 150000
    min_synteny_score = 0.6  // 60% flanking gene conservation required
    min_hit_identity = 10
    min_hit_length = 10
    min_query_length = 30  // reject queries shorter than this (aa); set to 0 to disable
    search_evalue = 0.01
    max_intron = 20000
    // GOI fallback hit-chain max-gap: derived from the home GOI's OWN largest intron
    // (goi_info.json) x margin, so two far-apart spurious hits aren't stitched into one
    // gene without hand-tuning max_intron per gene. Floor covers compact/single-exon
    // genes; falls back to max_intron when the home GOI structure is unavailable.
    goi_fallback_intron_margin = 5.0
    goi_fallback_intron_floor  = 10000

    // Locus splitting (split_loci.py) — guards against paralog-family blowups (docs/TODO.md §1d).
    // Firefly luciferase (an AMP-binding/acyl-CoA synthetase family member) produced 49 home
    // loci and a ~55 h run before this cap existed; the two real loci ranked 1st and 2nd.
    max_loci = 5                     // hard cap on distinct home loci to search
    locus_min_bit_ratio = 0.5        // keep a secondary locus only if best_bit >= this * primary_bit
    family_warning_threshold = 10    // warn when the pre-filter locus count exceeds this
    
    // Smith-Waterman search (for GOI in regions)
    enable_smith_waterman = true  // Use rigorous SW alignment for GOI
    sw_method = "auto"  // auto, parasail, or ssearch36
    allow_missing_smith_waterman = false  // fail loud if SW requested but parasail unavailable (SW is load-bearing for divergent GOI recovery); set true to proceed degraded
    sw_min_score = 20
    sw_min_identity = 10.0
    sw_timeout_seconds = 300
    
    // Augmentation / adaptive search
    region_padding = 150000
    padding_min = 50000
    padding_max = 200000
    aug_relaxed_evalue_mult = 1000
    aug_relaxed_evalue_cap = 10.0
    aug_relaxed_parse_evalue_mult = 10
    aug_relaxed_identity_factor = 0.6
    aug_relaxed_identity_min = 15.0
    aug_relaxed_length_div = 2
    aug_relaxed_length_min = 15
    aug_dedup_bin_bp = 100
    max_blocks_per_genome = 80
    min_block_genes = 2
    max_consecutive_empty_blocks = 25

    // §1m collinearity-aware seed placement (proper fix for the flanking-gap "fumble":
    // a GOI whose immediate neighbours are rearranged sits in a gap between flanking
    // sub-blocks and is never searched). Blocks are scored by their longest collinear
    // run of home-ordered flanking genes, and two same-chromosome clusters are bridged
    // into one block across a large gap when the flanking continue that run. Replaces
    // the after-the-fact §17 hull rescue. Set disable_synteny_collinearity=true for the
    // legacy gene-count behaviour.
    disable_synteny_collinearity = false
    synteny_bridge_max_gap       = 6000000   // max bp gap to bridge when collinear (0 = off)
    synteny_bridge_max_rank_gap  = 5         // max home-rank jump still a "continuation"
    synteny_bridge_min_anchors   = 3         // min anchored flanking genes before bridging

    // §A1 (TODO_JUN) — "the fumble": for a short precursor the conserved mature
    // peptide is only a fraction of the query, so a real divergent hit is
    // structurally low-coverage. Short-query GOI fallbacks gate on aligned
    // length + bitscore instead of query coverage, so the real model is emitted
    // in its own flanking-seeded block (not crowded out by a high-coverage
    // artifact elsewhere). Set fallback_short_query_len=0 for the legacy gate.
    fallback_short_query_len   = 150         // queries < this (aa) use the bitscore/aln gate (0 = legacy)
    fallback_short_min_aln_aa  = 15          // min aligned aa for a short-query fallback
    fallback_short_min_bits    = 30          // min bitscore for a short-query fallback


    // Sensitivity
    mmseqs_sensitivity = 9.5
    mmseqs_split_memory_limit = '8G'
    mmseqs_verbosity = 1
    min_gene_identity = 30

    // A0 reproducibility (TODO_JUN §A0): force the per-region augmented GOI
    // MMseqs search to --threads 1 so marginal/divergent GOI hits are
    // deterministic run-to-run (the wave seed set otherwise cascades). Regions
    // are tiny, so the speed cost is small. Set false for the legacy fast path.
    deterministic_goi_search = true

    // Iterative search resource guards (local-safe defaults)
    iterative_search_cpus = 2
    iterative_search_memory = '10 GB'
    iterative_search_max_forks = 1
    iterative_quiet_subtools = true

    // Classification thresholds (GOI confidence / model status)
    classify_high_min_identity = 50.0     // lowered from 60 for cross-vertebrate orthologs
    classify_medium_min_identity = 35.0   // lowered from 45 for divergent orthologs
    classify_tandem_min_identity = 40.0
    classify_tandem_min_qcov = 0.35       // §A2: tandem copy needs real coverage, not just local-window identity
    classify_high_min_collinear = 3       // §1: HIGH needs a collinear flanking run this long once a block has >=3 flanking (scrambled paralog neighbourhood -> MEDIUM); 0 = count-only/legacy
    classify_fragment_max_qcov = 0.4

    // §A3 (TODO_JUN) — un-neuter the wave seed (opt-in). When on, a HIGH/MEDIUM
    // GOI feature seeds the expanding DB regardless of goi_class (incl.
    // tandem_goi_copy) when its flanking support + query coverage clear the
    // floors, so a close relative's perfect/divergent ortholog bridges to the
    // next wave. Default OFF until the melittin_full rerun validates it doesn't
    // drift onto paralogs (TP53/LY6).
    seed_on_flanking_support = false
    seed_flanking_min_count  = 2          // §A3: min flanking genes for flanking-supported seeding
    seed_flanking_min_qcov   = 0.5        // §A3: min query coverage for flanking-supported seeding
    // §A4: bin waves by phylo-distance RANK so a saturated metric (tight clade,
    // all dist≈0.99) still grades close→far — the precondition for A3's
    // closest-first seeding. Default OFF (legacy absolute-threshold binning).
    rank_wave_binning        = false
    classify_complete_min_qcov = 0.7

    // Strict family-consistency gate (Change A). When true, fallback/rescued_exon/
    // raw_hit GOI calls whose TargetGene/TargetProduct does not match the family
    // tokens are downgraded to LOW/ambiguous. Tokens auto-derived from the query
    // FASTA header (GN=...) unless overridden.
    strict_goi_family = false
    goi_family_tokens = ''
    locate_gene_cpus = 1
    locate_gene_memory = '3 GB'

    // PLM (Protein Language Model) embedding search
    // Uses ProtT5-XL to detect remote homologs via embedding similarity.
    // Requires: pip install torch transformers sentencepiece  (optional)
    enable_plm_search = false          // Enable ProtT5 embedding search
    plm_device = 'cpu'                 // 'cpu' or 'cuda' (GPU accelerated)
    plm_similarity_threshold = 0.5     // Min cosine similarity for ORF discovery
    plm_medium_threshold = 0.7         // Embedding sim ≥ this → can boost LOW → MEDIUM
    plm_high_threshold = 0.85          // Embedding sim ≥ this → can boost MEDIUM → HIGH

    // Structural search (ESMFold + Foldseek)
    // Predicts 3D structures for candidate ORFs and compares against GOI
    // via Foldseek 3Di structural alphabet. Catches divergent orthologs
    // where even PLM embeddings fail (structure diverges ~10x slower than sequence).
    // Requires: pip install torch transformers; conda install -c bioconda foldseek
    enable_structural_search = false       // Enable ESMFold + Foldseek search
    structural_device = 'cpu'              // 'cpu' or 'cuda' (GPU strongly recommended)
    structural_tm_threshold = 0.3          // Min TM-score for Foldseek ORF discovery
    structural_medium_threshold = 0.5      // TM-score ≥ this → can boost LOW → MEDIUM
    structural_high_threshold = 0.7        // TM-score ≥ this → can boost MEDIUM → HIGH
    structural_max_length = 700            // Max residues for ESMFold (VRAM safety)
    enable_structural_discovery = false    // Fold region ORFs to discover sequence-invisible orthologs
    discovery_min_tm = 0.7                 // Min Foldseek TM-score to materialise a discovery model
    // Discovery guards (reject promiscuous-fold false positives — a TM match
    // alone can't tell an ortholog from a fold analogue; oskar's OSK domain is a
    // lipase fold). See bin/discover_regions.validate_discovery_hit.
    discovery_min_len_ratio = 0.5          // Guard 1: reject ORF < this × GOI length
    discovery_max_len_ratio = 2.0          // Guard 1: reject ORF > this × GOI length
    discovery_min_goi_coverage = 0.5       // Guard 2: SW alignment must span ≥ this fraction of the GOI
    discovery_paralog_margin = 1.0         // Guard 3: GOI score must beat best home-paralog score by this ×
    discovery_min_block_flanking = 2       // Guard 4a: ≥ this many flanking anchors near the ORF window
    discovery_allow_offblock = false       // Guard 4b: allow rescue off the sequence-GOI chromosome

    // §1o — dispersed-GOI rescue: recover a strong GOI hit that drifted away from
    // its flanking anchors (same-chromosome macrosynteny) when the neighbourhood
    // is rearranged. No-op on well-conserved targets (rearrangement gate). See
    // bin/iterative_search_runner.compute_rearrangement_score / select_dispersed_goi_seeds.
    enable_dispersed_goi_rescue = true     // Seed a block from a dispersed strong GOI hit
    dispersed_goi_min_identity = 40.0      // Min %identity for a dispersed GOI hit to be rescued
    dispersed_goi_max_evalue = 1e-10       // Max e-value for a dispersed GOI hit
    dispersed_goi_min_alnlen = 50          // Min alignment length (aa/bp)
    dispersed_min_chrom_anchors = 3        // Chromosome must carry ≥ this many flanking genes to define an envelope
    dispersed_envelope_margin = 200000     // Pad the flanking envelope by this many bp each side

    // GPU scheduling for the ML search steps (PLM / structural). Only relevant
    // under a grid executor (e.g. SLURM). The GPU request is applied to
    // ITERATIVE_SEARCH *only* when enable_plm_search or enable_structural_search
    // is true — a plain synteny run never asks the scheduler for a GPU. Set these
    // for your cluster (e.g. the `lrz_ai` profile pre-fills sensible LRZ values).
    //   gpu_partition       — SLURM partition that carries GPUs (queue name)
    //   gpu_cluster_options — extra sbatch flags to request the GPU (e.g. gres)
    // Leave gpu_partition empty to keep ITERATIVE_SEARCH on the default queue.
    gpu_partition = ''
    gpu_cluster_options = '--gres=gpu:1'

    // Annotation windows and filters
    gff_search_window = 100000
    gap_search_window = 50000
    gap_min_size = 10
    gap_evalue = 10
    gap_min_identity = 15.0
    gap_min_alnlen = 10
    gap_max_hits = 5
    min_exon_query_cov = 0.25
    min_exon_alnlen = 30

    // Gene prediction
    // Augustus (eukaryotes) or Prodigal (prokaryotes). Default: auto (prefer Augustus).
    // Prodigal cannot predict intron-containing genes — use Augustus for eukaryotes!
    gene_predictor = 'auto'           // 'auto', 'augustus', or 'prodigal'
    augustus_species = 'fly'           // Augustus species model (e.g. fly, human, honeybee1)
    pred_flank_window = 50000
    pred_keep_pct = 0.10
    prodigal_full_genome_fallback = false

    // Synteny scoring weights
    synteny_weight_base = 0.4
    synteny_weight_consistency = 0.3
    synteny_weight_strand = 0.3
    synteny_goi_overlap_bonus = 0.15
    max_regions = 0                  // 0 = adaptive (emit all above threshold, cap 6)
    // Adaptive region selection (only used when max_regions=0). Defaults match
    // previous hard-coded behavior so non-strict runs are unaffected.
    adaptive_score_floor_frac = 0.30
    adaptive_score_floor_abs  = 0.03
    adaptive_max_regions      = 6
    adaptive_unique_gene_floor = 3
    // §1e: a block with >= this many HIGH-confidence flanking genes but no GOI model
    // is surfaced as 'goi_missing_but_strong_synteny' (MEDIUM) instead of being dropped.
    strong_synteny_min_flanking = 5
    // §1e follow-up: relaxed-miniprot rescue pass inside goi_missing_but_strong_synteny
    // blocks. Emits SynVoyRole=goi rows tagged Confidence=LOW + EvidenceType=
    // relaxed_miniprot_rescue so users get *some* model to inspect.
    disable_strong_synteny_rescue          = false
    strong_synteny_rescue_miniprot_outc    = 0.05  // min 5% query coverage to emit
    strong_synteny_rescue_window_pad       = 2000  // bp added each side of block coords
    strong_synteny_rescue_miniprot_timeout = 120   // seconds per block
    // §1m fumble fix — GOI synteny-HULL rescue. When the GOI sits in a GAP between
    // flanking-seeded sub-blocks (its neighbours rearranged in the target), SynVoy never
    // searches it and misses the true ortholog (cow decorin chr5:21 Mb fell between blocks
    // → recovered only 55% paralog fragments; miniprot finds the true 90% decorin there).
    // This runs miniprot of the GOI across the whole flanking neighbourhood per target
    // chromosome — but only when there are >= goi_hull_min_flanking HIGH flanking genes and
    // NO HIGH GOI model already inside the hull (so it's a no-op where the GOI is already
    // recovered → validated single-copy benchmarks are untouched).
    disable_goi_hull_rescue                = false
    goi_hull_min_flanking                  = 4         // min HIGH flanking in the hull to attempt rescue
    goi_hull_cluster_max_gap               = 3000000   // bp gap splitting flanking into clusters
    goi_hull_window_pad                    = 100000    // bp pad around the hull window
    goi_hull_max_window                    = 20000000  // skip hull windows larger than this (bp)
    goi_hull_min_identity                  = 40.0      // min miniprot %identity to emit a rescued model
    goi_hull_min_coverage                  = 0.5       // min query coverage (CDS aa / query len)
    // §1j Phase B: reciprocal-best paralog check across home paralogs. No-op when
    // params.query has a single sequence. Set true to skip even on multi-paralog runs.
    disable_paralog_check       = false
    paralog_confusion_min_gap   = 5.0  // require this many bitscore points of margin to flag
    // §1m: locus ownership. Build a home-paralog panel (the home GOI-family gene at
    // each split locus) and SW-align every recovered GOI target against it; the best
    // panel match names the home locus a target TRULY belongs to. generate_report.py
    // re-attributes orthologs filed under the wrong home locus and relabels paralogs
    // carried under the GOI name (decorin recovered by the chr9 OMD locus → re-filed
    // under the chr12 DCN locus; asporin @ 49.5% labelled GOI_DCN → flagged). Set true
    // to skip; automatic no-op when only one home locus exists.
    disable_locus_ownership                 = false
    require_paralog_panel                   = true    // fail loud if the §1m home-paralog panel crashes (e.g. parasail missing) instead of silently skipping ownership; false = tolerate
    locus_ownership_pad                     = 2000    // bp padding when intersecting genes with a locus span
    locus_ownership_max_genes_per_locus     = 5       // cap panel entries per locus (tandem clusters)
    locus_ownership_tiebreak_gap            = 10.0    // SW-score margin below which RBH is "ambiguous" → synteny tiebreak
    locus_ownership_synteny_window          = 200000  // bp window for the flanking co-location tiebreak
    // Home-paralog panel FAMILY augmentation (the decorin/biglycan fix): split_loci spans
    // only capture LRR cross-hits (FLRT/LRRC4), missing the real paralogs. Seed the RBH
    // panel with the GOI's closest home homologs (DCN→BGN/ASPN) so a recovered call whose
    // best home match is biglycan gets flagged paralog_not_goi + demoted from the headline.
    paralog_panel_min_identity              = 28.0    // min %id (query vs home protein, with a coverage guard) to include a paralog
    paralog_panel_max_family                = 15      // cap homology-based family entries (closest paralogs by identity)
    // §1n — two-path home-locus establishment (name-lookup path). When the GOI is a
    // named gene present in the home GFF, take that SINGLE annotated locus + its true
    // flanking neighbours and bypass the noisy locate_gene/split_loci fan-out (which
    // for gene families keeps the wrong loci and anchors on a paralog's neighbourhood —
    // the decorin→asporin failure). Opt-in: validated melittin/LY6/TP53 paths are
    // untouched unless enabled. A query↔gene consistency check guards against name
    // typos / wrong species; any miss falls back to alignment-locate.
    enable_name_locus       = false   // turn on the name-lookup path (also auto-on when home_goi_gene is set)
    home_goi_gene           = ''      // force the GOI gene symbol (implies enable_name_locus); else use the resolved UniProt symbol
    name_locus_min_identity = 60.0    // min %identity (query vs looked-up gene protein) to accept the name match
    name_locus_pad          = 0       // bp pad added either side of the gene span in the locus BED
    // §1f: LOCATE_GENE emits hit_profile.json + an advisory query-type preset
    // (auto_preset.json). Set --preset_override to a preset name (e.g.
    // preset_paralog_discrimination) to pin the choice; empty = let the hit
    // distribution choose.
    preset_override = ''
    // §1f auto-apply: when true (default), the chosen preset's overrides are
    // applied at runtime to EXTRACT_FLANKING / ITERATIVE_SEARCH / CLUSTER_REGIONS
    // via a value channel (RESOLVE_EFFECTIVE_PARAMS). Note: NORMALIZE_QUERY runs
    // BEFORE LOCATE_GENE so its min_query_length cannot be auto-applied — pass it
    // explicitly (or use `-profile preset_short_peptide` at launch) for queries
    // shorter than the default min_query_length.
    // Set to false to keep auto-preset advisory-only (legacy behaviour); a user-set
    // CLI value for any preset-affected param will then survive into downstream steps.
    auto_apply_preset = true

    // §1g: per-target phylogenetic-distance auto-tune. SynVoy uses one global
    // identity stringency for every target, so a divergent ortholog in a distant
    // relative gets dropped at the same bar that a close relative clears easily.
    // ITERATIVE_SEARCH now estimates each target's distance from the *median
    // identity of its flanking-gene matches* (data-driven; no tree/network) and
    // relaxes the GOI classify identity bars (classify_high/medium_min_identity)
    // for distant targets only. By construction it is a NO-OP for close relatives
    // (median flanking identity >= close_pct), so well-conserved benchmarks are
    // unaffected; it can only add (never remove) calls in distant genomes, and
    // the far tier flags manual_review.
    disable_distance_autotune      = false  // set true to keep one global stringency
    distance_autotune_close_pct    = 70.0   // median flanking identity >= this -> no relaxation
    distance_autotune_far_pct      = 40.0   // <= this -> full relaxation (+ manual_review)
    distance_autotune_max_relax    = 10.0   // max identity-points subtracted from the HIGH/MEDIUM bars
    distance_autotune_min_flanking = 3      // need this many flanking genes to trust the estimate

    // Output and Plotting
    outdir = 'results'
    plot_width = 1500
    gap_threshold = 50000
    gap_visual_size = 20000
    flank_fallback_bp = 1000000
    scale_bar_len = 10000
    hide_goi_absent_tracks = true
    pub_svg = false          // Generate narrow publication SVG (opt-in; the _view.svg mirror is always emitted)
    pub_width_mm = 183       // SVG width in mm (Nature double column)
    pub_palette = 'okabe_ito' // Colorblind-safe palette
    enable_matrix_plot = false // Phylogeny-anchored presence/absence matrix. Off by
                               // default: the anchor-grid (aligned columns + species
                               // tree) and the gene-position map now cover it more
                               // compactly. Set true to also emit *_synteny_matrix.svg.

    docker_container = 'synvoy-local:latest'

    // LLM Parameter Estimation
    // When enabled, SynVoy analyzes the query gene, home species, and target
    // genomes to automatically estimate optimal search parameters via a cloud LLM.
    // Falls back to rule-based heuristics when no API key is set.
    auto_params = false                    // Enable automatic parameter estimation (requires llm_api_key)
    force_disable_advanced_search = false  // Prevent auto-params from enabling optional PLM/structure search
    llm_provider = 'google'               // LLM provider: 'google' (Gemini) or 'openai' (OpenAI / compatible)
    llm_api_key = ''                      // API key — also read from LLM_API_KEY, GOOGLE_API_KEY, OPENAI_API_KEY env vars
    llm_api_base_url = ''                 // Custom base URL for OpenAI-compatible providers (leave empty for openai.com)
    llm_model = ''                        // Model override — leave empty for provider default (gemini-2.5-flash-lite / gpt-4o-mini)
    // Multi-profile mode: run with multiple parameter sets and pick the best
    multi_profile = false                  // Enable multi-profile mode (auto-disabled when too expensive)
    multi_profile_max_jobs = 30            // Max total jobs (loci × targets × profiles) for multi-profile
    
    // Advanced options
    keep_intermediate = false  // Set to true for debugging
    max_retries = 3

    // Internal resource defaults. Profiles may override these; keeping the
    // global process block param-driven avoids profile values being clobbered
    // by later withName selectors under strict config parsing.
    default_cpus = 1
    default_memory = '2 GB'
    // Default wall-clock for processes without an explicit `time` override.
    // Ignored by the local executor; enforced by grid executors (SLURM kills
    // the job at the wall). Kept generous so light/medium steps never hit a
    // surprise cutoff, and the global block scales it by task.attempt so a
    // genuine timeout retries with MORE time instead of re-dying at the same wall.
    default_time = '4h'

    // Terminal output: when true (default) the per-step [RUN]/[SKIP] status
    // announcements and phase banners are suppressed so they don't fight
    // Nextflow's live status table (each one forces a full table reprint).
    // The banner, the [OK] result lines, warnings, errors and the final Run
    // Summary always print. Set `--quiet false` for the old verbose stream.
    quiet = true
    compute_tree_cpus = 2
    compute_tree_memory = '4 GB'

    // Skip the per-locus MAFFT + IQ-TREE phylogeny (COMPUTE_TREE). The tree's
    // current analytical value is marginal and IQ-TREE is a real time/RAM cost
    // on weak machines, so this is forced ON by the `low_mem` profile. When
    // true, COMPUTE_TREE emits a placeholder newick (the same one the process
    // already produces for <3 sequences) so plotting still works.
    skip_tree = false
}

// Pass LLM API key to executors (supports all three env var conventions)
env {
    LLM_API_KEY = params.llm_api_key ?: (env('LLM_API_KEY') ?: (env('GOOGLE_API_KEY') ?: (env('OPENAI_API_KEY') ?: '')))
}

// Profiles
profiles {
    standard {
        process.executor = 'local'
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    // ─── Recommended zero-config entry point (§1a auto umbrella) ──────────
    // For users who don't want to — or can't — hand-tune per-query parameters
    // (the Bachelor-cohort default). Self-contained: runs locally through the
    // conda env exactly like `standard`, and additionally PINS the full
    // auto-tuning stack on. Those knobs are already default-on; pinning them
    // here guarantees a stray `-c` config or a composed profile can't silently
    // disable them, and gives users one discoverable switch:
    //   §1f  auto_apply_preset   — pick the query preset from the LOCATE_GENE
    //                              hit profile (short_peptide / single_copy /
    //                              tandem_family / paralog_discrimination)
    //   §1d  max_loci = 5        — hard cap on home loci (big-family guard)
    //   §1e  strong-synteny rescue + reporting of GOI-missing strong blocks
    //   §1j  reciprocal-best paralog check + self-consistency flags
    //
    // Does NOT enable auto_params (the LLM advisor) — that needs Ollama / a
    // cloud key, so it stays opt-in via `--auto_params true`.
    //
    //   §1g  per-target phylogenetic-distance stringency auto-tune
    //
    //   Small machine?  compose a memory tier:   -profile auto,low_mem
    //   Pin a preset instead of auto-picking:     --preset_override preset_X
    //
    // Docker / Singularity / HPC users already get this behaviour for free
    // (the stack is default-on), so they keep using their execution profile.
    auto {
        process.executor = 'local'
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
        process.conda = "${projectDir}/environment.yml"

        params.auto_apply_preset             = true
        params.max_loci                      = 5
        params.disable_strong_synteny_rescue = false
        params.disable_paralog_check         = false
        params.disable_distance_autotune     = false   // §1g per-target stringency auto-tune
        params.disable_locus_ownership       = false   // §1m home-paralog ownership re-attribution
        params.disable_locus_ownership       = false   // §1m home-paralog locus ownership
    }

    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
        process.conda = "${projectDir}/environment.yml"
    }

    // Conservative local profile for ~16 GB laptops/workstations that may
    // otherwise freeze under MMseqs/tBLASTN load on large (vertebrate) genomes.
    //
    // Tighter than `standard` on the only knobs that actually bound peak RAM:
    // mmseqs_split_memory_limit (per-split target-DB ceiling) and the
    // ITERATIVE_SEARCH task memory. Sensitivity is dialled down because
    // sensitivity 9.5 is overkill for the well-conserved cases that fit on
    // a laptop (single-copy orthologs, intra-clade comparisons).
    laptop_safe {
        process.executor = 'local'
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
        process.conda = "${projectDir}/environment.yml"

        params.iterative_search_cpus = 1
        params.iterative_search_memory = '8 GB'
        params.iterative_search_max_forks = 1
        params.locate_gene_cpus = 1
        params.locate_gene_memory = '2 GB'
        params.mmseqs_split_memory_limit = '4G'
        params.mmseqs_sensitivity = 8.0
        params.mmseqs_verbosity = 0
        params.iterative_quiet_subtools = true

        process {
            maxForks = 1
        }
    }

    // Truly memory-constrained profile (~8 GB RAM machines, e.g. older student
    // laptops). Halves every memory ceiling vs `laptop_safe` and drops mmseqs
    // sensitivity further so vertebrate-scale targets (1-3 GB genomes -> 3-9 GB
    // 6-frame translated DBs) can still complete without "cannot fit database
    // into memory" / "not enough memory to keep dbreader/write" errors.
    //
    // Trade-off: slower runs and slightly lower recall on highly divergent
    // queries. Combine with a biology preset, e.g.:
    //   -profile standard,low_mem,preset_single_copy
    low_mem {
        process.executor = 'local'
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
        process.conda = "${projectDir}/environment.yml"

        params.iterative_search_cpus = 1
        params.iterative_search_memory = '4 GB'
        params.iterative_search_max_forks = 1
        params.locate_gene_cpus = 1
        params.locate_gene_memory = '2 GB'
        params.mmseqs_split_memory_limit = '2G'
        params.mmseqs_sensitivity = 7.0
        params.mmseqs_verbosity = 0
        params.iterative_quiet_subtools = true
        params.skip_tree = true          // drop the per-locus MAFFT+IQ-TREE phylogeny on weak machines

        process {
            maxForks = 1
        }
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }

    // Host-maximizing Docker profile (single-job saturation).
    // Uses almost all local CPU/RAM while keeping a tiny safety margin.
    // Resource detection stays inside the profile closure so Nextflow 26.04
    // strict config parsing accepts it.
    docker_max {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false

        params._host_cpus = Runtime.runtime.availableProcessors() > 0 ? Runtime.runtime.availableProcessors() : 2
        params._host_mem_gb = new File('/proc/meminfo').exists()
            ? (((((new File('/proc/meminfo').readLines().find { line -> line.startsWith('MemTotal:') } ?: 'MemTotal: 8388608 kB').split(':')[1].trim().split(/\s+/)[0] as Long) / 1048576) as int) > 2
                ? ((((new File('/proc/meminfo').readLines().find { line -> line.startsWith('MemTotal:') } ?: 'MemTotal: 8388608 kB').split(':')[1].trim().split(/\s+/)[0] as Long) / 1048576) as int)
                : 2)
            : 8
        params._docker_max_mem_gb = params._host_mem_gb > 3 ? params._host_mem_gb - 1 : 2
        params._iterative_max_mem_gb = params._host_mem_gb > 4 ? params._host_mem_gb - 2 : 2
        params._mmseqs_split_max_gb = ((params._iterative_max_mem_gb * 0.70) as int) > 2 ? ((params._iterative_max_mem_gb * 0.70) as int) : 2

        params.iterative_search_cpus = params._host_cpus
        params.iterative_search_memory = "${params._iterative_max_mem_gb} GB"
        params.iterative_search_max_forks = 1
        params.locate_gene_cpus = params._host_cpus
        params.locate_gene_memory = "${params._docker_max_mem_gb} GB"
        params.mmseqs_split_memory_limit = "${params._mmseqs_split_max_gb}G"
        params.default_cpus = params._host_cpus
        params.default_memory = "${params._docker_max_mem_gb} GB"
        params.compute_tree_cpus = params._host_cpus
        params.compute_tree_memory = "${params._docker_max_mem_gb} GB"

        process {
            cpus = params._host_cpus
            memory = "${params._docker_max_mem_gb} GB"
            maxForks = 1

            withName: 'ITERATIVE_SEARCH' {
                cpus = params._host_cpus
                memory = "${params._iterative_max_mem_gb} GB"
                maxForks = 1
            }
            withName: 'LOCATE_GENE' {
                cpus = params._host_cpus
                memory = "${params._docker_max_mem_gb} GB"
            }
            withName: 'COMPUTE_TREE' {
                cpus = params._host_cpus
                memory = "${params._docker_max_mem_gb} GB"
            }
        }
    }
    
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    
    slurm {
        process.executor = 'slurm'
        process.queue = 'normal'  // Change to your cluster's partition
        process.clusterOptions = '--account=your_account'  // Optional: billing account
        // Uncomment and adjust for your cluster:
        // process.queue = 'gpu'  // or 'long', 'batch', etc.
        // executor.queueSize = 50  // Max jobs to submit at once
        // executor.submitRateLimit = '10/1min'  // Rate limit submissions
    }
    
    // Combined profiles for common HPC setups
    hpc_singularity {
        process.executor = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${env('HOME')}/.singularity/cache"
        docker.enabled = false
        conda.enabled = false
    }
    
    hpc_conda {
        process.executor = 'slurm'
        conda.enabled = true
        conda.useMamba = true
        docker.enabled = false
        singularity.enabled = false
        process.conda = "${projectDir}/environment.yml"
    }

    // LRZ AI Systems (GPU) — runs the ML search steps (PLM / structural) on GPU.
    // Compose with the ML toggles, e.g.
    //     nextflow run main.nf -profile lrz_ai \
    //         --enable_plm_search true --enable_structural_search true ...
    // IMPORTANT: set `gpu_partition` to a real AI Systems partition before use —
    // run `sinfo -o "%P %G"` on the login node to list GPU partitions (names look
    // like `lrz-hgx-h100-94x4`, `lrz-hgx-a100-80x4`, `mcml-hgx-a100-80x4`, ...).
    // The GPU request only fires when an ML search step is enabled (see the
    // ITERATIVE_SEARCH process block); plain synteny stays CPU-only.
    lrz_ai {
        process.executor = 'slurm'
        conda.enabled = true
        conda.useMamba = true
        docker.enabled = false
        singularity.enabled = false
        process.conda = "${projectDir}/environment.yml"
        params.gpu_partition = ''                       // ← FILL IN: e.g. 'lrz-hgx-h100-94x4'
        params.gpu_cluster_options = '--gres=gpu:1'
        params.plm_device = 'cuda'
        params.structural_device = 'cuda'
        // Reduce CUDA allocator fragmentation so ESMFold fits on 16 GB-class
        // GPUs (e.g. the V100). Set at the task-env level so it takes effect
        // before torch initialises its allocator, even if an earlier GPU step
        // touched CUDA first. Harmless on CPU-only tasks.
        env.PYTORCH_CUDA_ALLOC_CONF = 'expandable_segments:True'
        env.PYTORCH_ALLOC_CONF = 'expandable_segments:True'
        executor.queueSize = 50
        executor.submitRateLimit = '10/1min'
    }

    // LRZ AI Systems (GPU) — CONTAINER mode (recommended; AI Systems is container-only,
    // no conda/pip/module). Nextflow has no native Enroot/pyxis backend, so the WHOLE
    // pipeline runs INSIDE one Enroot .sqsh as a single SLURM job with the LOCAL executor.
    // The container already carries the env (environment.yml + environment-ml.yml), so
    // conda is OFF here; the GPU comes from the enclosing salloc/sbatch (--gres=gpu:N),
    // not per-process. Launch from inside an salloc (or an sbatch script):
    //   srun --container-image=$HOME/synvoy-ml.sqsh \
    //        --container-mounts=$HOME/SynVoy:/workspace,$HOME/hf_cache:/hf_cache \
    //        --pty bash -lc 'export HF_HOME=/hf_cache; cd /workspace; \
    //          micromamba run -n base nextflow run main.nf -profile lrz_ai_container \
    //            --enable_plm_search true --enable_structural_search true ...'
    lrz_ai_container {
        process.executor = 'local'
        conda.enabled = false
        docker.enabled = false
        singularity.enabled = false
        params.plm_device = 'cuda'
        params.structural_device = 'cuda'
        params.gpu_partition = ''          // GPU is provided by the enclosing salloc/sbatch
        params.gpu_cluster_options = ''
        // Reduce CUDA allocator fragmentation so ESMFold fits on 16 GB-class GPUs.
        env.PYTORCH_CUDA_ALLOC_CONF = 'expandable_segments:True'
        env.PYTORCH_ALLOC_CONF = 'expandable_segments:True'
    }

    test {
        includeConfig 'conf/test.config'
    }
    test_melettin {
        process.executor = 'local'
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
        includeConfig 'conf/test_melettin.config'
    }
    test_tetramorium {
        includeConfig 'conf/test_tetramorium.config'
    }

    // ─── Query-type presets ──────────────────────────────────────────────
    // Bundles of GOI/family/classification parameters tuned for common gene
    // archetypes. Pick the one matching your query and compose with an
    // execution profile, e.g.
    //     nextflow run main.nf -profile standard,preset_short_peptide ...
    //     nextflow run main.nf -profile docker,preset_tandem_family ...
    // See docs/PARAMETERS.md §Presets for the decision tree.

    preset_short_peptide {
        includeConfig 'conf/presets/short_divergent_peptide.config'
    }
    preset_tandem_family {
        includeConfig 'conf/presets/tandem_family.config'
    }
    preset_single_copy {
        includeConfig 'conf/presets/single_copy_conserved.config'
    }
    preset_paralog_discrimination {
        includeConfig 'conf/presets/paralog_discrimination.config'
    }
}

// Process-specific resource requirements
process {
    // Default
    cpus = params.default_cpus as Integer
    memory = params.default_memory
    // Scales with attempt: a timeout (SLURM SIGTERM → 143, TIMEOUT → 140) now
    // retries with MORE wall-clock instead of re-dying at the same limit, which
    // is what the previous fixed `time = '1h'` did to slow STAGE_GENOMES.
    time = { (params.default_time as nextflow.util.Duration) * task.attempt }

    errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'terminate' }
    maxRetries = 2
    
    withName: 'ITERATIVE_SEARCH' {
        cpus = params.iterative_search_cpus as Integer
        memory = params.iterative_search_memory
        maxForks = params.iterative_search_max_forks as Integer
        time = '48h'
        // GPU is requested ONLY when an ML search step is enabled AND a GPU
        // partition is configured (see params.gpu_partition / gpu_cluster_options).
        // A plain synteny run stays on the default queue and never asks for a GPU.
        // Ignored by the local executor; honored by SLURM.
        queue = { (params.enable_plm_search || params.enable_structural_search) && params.gpu_partition ? params.gpu_partition : null }
        clusterOptions = { (params.enable_plm_search || params.enable_structural_search) && params.gpu_partition ? params.gpu_cluster_options : null }
    }
    withName: 'LOCATE_GENE' {
        cpus = params.locate_gene_cpus as Integer
        memory = params.locate_gene_memory
        time = '48h'
    }
    withName: 'PHYLO_SORT' {
        memory = '8 GB'
    }
    withName: 'FETCH_RELATED_GENOMES' {
        time = '3h'
        maxRetries = 3
    }
    withName: 'FETCH_HOME_GENOME' {
        time = '3h'
        maxRetries = 3
    }
    withName: 'COMPUTE_TREE' {
        cpus = params.compute_tree_cpus as Integer
        memory = params.compute_tree_memory
        time = '4h'
    }
    withName: 'PREPARE_HOME_PROTEOME' {
        time = '3h'
    }
    withName: 'ANNOTATE_GOI' {
        time = '3h'
    }
    withName: 'EXTRACT_FLANKING' {
        time = '3h'
    }
}

// Container definitions (used when docker or singularity profile is active)
// Single container with all tools - simpler than per-process containers
process {
    // Build the bundled Dockerfile as `synvoy-local:latest`, or override with:
    //   --docker_container your/image:tag
    container = params.docker_container
    // Ensure workspace scripts override packaged container scripts.
    beforeScript = "export PATH=${projectDir}/bin:\$PATH"
}

// Conda settings
conda {
    // First-run env solve + download of the full bioconda stack can exceed an
    // hour on a slow/shared cluster filesystem; the old '1 h' aborted the build
    // mid-solve. 3 h gives headroom (this is a one-time cost — the env is cached).
    createTimeout = '3 h'
    useMamba = true  // Use mamba for faster env creation (if available)
}
