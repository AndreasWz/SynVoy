// Demo overrides, applied on top of `-profile low_mem`.
//
// Kept in a config file so the demo command stays short and the choices are written
// down next to their reasons.

params {
    // low_mem disables the per-locus MAFFT + IQ-TREE phylogeny. The tree is worth
    // showing, so it is restored here.
    skip_tree = false

    // NOT raised back to 9.5. `low_mem` sets mmseqs_sensitivity = 7.0; on this demo 9.5
    // took about three times as long and gave the same STE2 calls, with a few more LOW
    // ones. Sensitivity buys nothing here because the genomes are 11 Mb and the anchors are
    // strongly conserved; it is worth paying on large/divergent targets, not on this demo.
    // mmseqs_sensitivity = 9.5
}
