// Demo overrides, applied on top of `-profile low_mem`.
//
// These live in a config file rather than on the command line ON PURPOSE:
// Nextflow hands every `--param value` to the pipeline as a **String**, and
// main.nf's validation block compares numeric params with `<` / `>`, so
// `--mmseqs_sensitivity 9.5` (or --max_intron, --cluster_distance, …) aborts the
// run with "Cannot compare java.lang.String with value '9.5'". See docs/TODO.md §1s.
// Values set here keep their numeric type and validate cleanly.

params {
    // low_mem disables the per-locus MAFFT + IQ-TREE phylogeny. The tree is worth
    // showing, so it is restored here.
    skip_tree = false

    // NOT raised back to 9.5. `low_mem` sets mmseqs_sensitivity = 7.0, and measured
    // on this demo 9.5 costs +8 min (3m49s -> 12m14s) for byte-identical STE2 calls:
    //     N. castellii  HIGH   66.0   |  K. lactis  MEDIUM 47.8  |  L. thermotolerans MEDIUM 41.9
    // at both settings. The only difference was 5 extra LOW-confidence junk calls.
    // Sensitivity buys nothing here because the genomes are 11 Mb and the anchors are
    // strongly conserved; it is worth paying on large/divergent targets, not on this demo.
    // mmseqs_sensitivity = 9.5
}
