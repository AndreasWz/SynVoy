// Fixed distances for the yeast demo, kept only to reproduce an experiment made with
// SynVoy versions that gave every distance in base pairs. The distances of the search are
// derived for each home locus and each target genome now (in yeast: block gap and window
// margin 20-35 kb, bridge limit 57-100 kb), so nothing has to be scaled by hand. This file
// fixes them in base pairs instead.
//
// The question: were the fixed distance defaults simply mis-scaled for a yeast genome?
// Every length parameter of those versions was tuned on insect and vertebrate genomes
// and expressed in absolute bp, so on an 11 Mb genome with 0.7-3 Mb chromosomes they
// cover a chromosome ARM rather than a neighbourhood:
//
//   default            metazoan meaning            on S. cerevisiae chrVI (270 kb)
//   ------------------ --------------------------- --------------------------------
//   cluster_distance   150 kb  ~ 7 genes           ~75 genes
//   region_padding     150 kb  ~ a locus margin    over half the chromosome
//   padding_max        200 kb                      most of the chromosome
//   bridge_max_gap       6 Mb  ~ one rearrangement larger than any yeast chromosome
//                                                  (so distance never constrains it)
//
// Yeast is ~10x denser in genes/Mb than an insect genome, so the distances are
// scaled down by 10x here. Compare with a run of the demo at the defaults.
params {
    skip_tree = true

    cluster_distance       = 15000
    region_padding         = 15000
    padding_min            = 5000
    padding_max            = 20000
    synteny_bridge_max_gap = 600000
    max_intron             = 2000     // yeast introns are <1 kb
}
