// Insect demo overrides, applied on top of `-profile low_mem`.
//
// Unlike demo.config (yeast) this keeps the tree OFF: on the yeast demo the per-locus
// MAFFT + IQ-TREE took more than half of the run. Turn it back on only if the tree
// is actually going to be shown.
//
// Everything else stays at the nextflow.config defaults ON PURPOSE: those defaults
// were tuned on insect and vertebrate genomes, so this run is also the check that they
// behave as intended on the genome scale they were designed for.
params {
    skip_tree = true

    // ONE home locus only. ITERATIVE_SEARCH runs once PER LOCUS per genome and is
    // 60-70 % of total runtime, so a gene family that splits into 5 home loci turns
    // a ~6 min demo into ~30 min. The audience picks the accession, so the locus
    // count is not knowable in advance — cap it.
    //
    // Safe because the PRIMARY locus comes first and is never removed: the annotated home
    // gene that matches the query (home_locus_mode auto), else the place where the query
    // protein aligns best in its own genome, i.e. the real gene. Capping at 1 drops
    // paralogs, not the target.
    // (Defensin already resolved to 1 locus unaided; this is insurance for e.g. an
    // Adh/Adhr- or actin-like pick.)
    max_loci = 1

    // NOT capping max_blocks_per_genome: a cap of 30 instead of 80 gave the same
    // results and no faster run, so the default stays rather than a change that could
    // drop a real block.
    // max_blocks_per_genome = 30
}
