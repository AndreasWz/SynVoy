// Insect demo overrides, applied on top of `-profile low_mem`.
//
// Unlike demo.config (yeast) this keeps the tree OFF. On the yeast demo the
// per-locus MAFFT + IQ-TREE cost 4 m 50 s of an 8 m 39 s run and produced a tree
// whose leaves were dominated by sub-30 % fallback models — see
// docs/analysis/ste2_yeast_demo_2026-07-21.md. Turn it back on only if the tree
// is actually going to be shown.
//
// Everything else stays at the nextflow.config defaults ON PURPOSE: those defaults
// were tuned on insect and vertebrate genomes (docs/TODO.md §1t), so this run is
// also the check that they behave as intended on the genome scale they were
// designed for.
params {
    skip_tree = true

    // ONE home locus only. ITERATIVE_SEARCH runs once PER LOCUS per genome and is
    // 60-70 % of total runtime, so a gene family that splits into 5 home loci turns
    // a ~6 min demo into ~30 min. The audience picks the accession, so the locus
    // count is not knowable in advance — cap it.
    //
    // Safe because split_loci.py ranks loci by `best_bit / primary_bit` and keeps the
    // PRIMARY first: locus 1 is where the query protein itself aligns best in its own
    // genome, i.e. the real gene. Capping at 1 drops paralogs, not the target.
    // (Defensin already resolved to 1 locus unaided; this is insurance for e.g. an
    // Adh/Adhr- or actin-like pick.)
    max_loci = 1

    // NOT capping max_blocks_per_genome. Tried 80 -> 30 on 2026-07-21: identical
    // results, and wall time went 5m34s -> 6m40s (i.e. no benefit, and within
    // run-to-run noise at best). The Anopheles run already retains only 25 of 145
    // candidate blocks at the default, so the cap was never binding. Left at the
    // default rather than shipping an unvalidated change that could drop a real block.
    // max_blocks_per_genome = 30
}
